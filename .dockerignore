# Dependencies and build outputs (reinstalled or rebuilt in the image)
node_modules
dist
tmp
out-tsc
bazel-out
.angular
*.tsbuildinfo

# Test, coverage, and E2E artifacts
coverage
playwright-report
test-results
.nyc_output
e2e
karma.conf.js
playwright.config.ts
**/*.spec.ts

# Git, IDE, and local editor config
.git
.gitignore
.gitattributes
.idea
.vscode
.cursor
*.log

# Dev containers and agent tooling (not used in production image)
.devcontainer
.agents

# CI, quality, and docs (not required for ng build)
.github
sonar-project.properties
codecov.yml
docs
*.md
!README.md

# Environment and secrets
.env
.env.*
!.env.example

# Alternate lockfiles (pnpm-lock.yaml is required)
package-lock.json
yarn.lock
bun.lock

# OS and misc
.DS_Store
Thumbs.db
*.local
*.swp
*.swo
