{
  "name": "temp-ng-project",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:lint": "pnpm lint && ng test",
    "test:watch": "ng test",
    "test:playwright": "playwright test",
    "test:coverage": "ng test --code-coverage && node scripts/check-coverage-warning.js",
    "test:coverage:playwright": "node scripts/run-playwright-coverage.mjs",
    "test:e2e": "npx playwright test --reporter=junit --reporter=html --output=test-results",
    "e2e:report": "playwright show-report",
    "check:all": "pnpm typecheck && pnpm lint && pnpm test:coverage:playwright"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ant-design/icons-angular": "^22.1.1",
    "@ctrl/tinycolor": "^4.2.1",
    "ng-zorro-antd": "^22.1.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.6.7",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/schematics": "22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/jasmine": "~5.1.15",
    "@types/node": "^25.9.9",
    "angular-eslint": "22.6.0",
    "eslint": "^9.39.5",
    "http-server": "^14.1.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "monocart-reporter": "^2.15.1",
    "testcontainers": "^11.14.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "http-proxy-middleware": ">=2.0.9",
      "webpack-dev-server": ">=5.2.1",
      "tmp": ">=0.2.4",
      "tar": ">=7.5.4",
      "lodash": ">=4.17.23",
      "hono": ">=4.11.7",
      "tar@<7.5.7": ">=7.5.7",
      "hono@<4.11.7": ">=4.11.7",
      "uuid@<11.1.1": ">=11.1.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "hono": ">=4.11.7"
      }
    }
  }
}